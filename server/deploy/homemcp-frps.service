[Unit]
Description=HomeMCP tunnel relay (frps, TLS passthrough data plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/frp/frps.env
ExecStart=/usr/local/bin/frps -c /etc/frp/frps.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
# frps binds 443/7000; it runs as root in this unit. The relay holds no
# tenant certificates and terminates no tenant TLS (SNI passthrough).

[Install]
WantedBy=multi-user.target
