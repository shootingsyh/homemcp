# Copy to .env.mock and edit before starting the mock instance:
#   cp .env.mock.example .env.mock
# NEVER commit .env.mock (it is in .gitignore). Placeholders only here.
# See README "Standalone mock instance (for client development)".

# Host port the mock tunneld API is published on. The client reaches
# the instance at API_PUBLIC_BASE below, so the two must agree:
# API_PUBLIC_BASE's port == MOCK_PORT (unless a proxy sits in front).
MOCK_PORT=7200

# The base URL the HomeMCP client will use for this mock instance:
# it is both the client's API base and the prefix of every mock
# checkout URL tunneld hands out (<base>/mock-pay/<enrollment_id>).
# Use the address the client dev machine can actually reach — this
# host's LAN IP or DNS name, e.g.:
API_PUBLIC_BASE=http://192.168.1.50:7200
# Replace 192.168.1.50 with the real address of the host running the
# mock instance. http://localhost:7200 only works when the client
# runs on the same machine as tunneld.

# Operator key for the admin views and the mock subscription-event
# test hook (sent as the X-Admin-Key header). deploy/run-mock.sh
# refuses to start while this is empty.
# Generate with: openssl rand -hex 32
TUNNELD_ADMIN_KEY=

# Parent domain for tenant subdomains handed out at claim time
# (<username>.tunnel.homemcp.si). Cosmetic in mock development — no
# DNS or frps is involved — keep it identical to production so client
# behavior matches what ships.
TUNNEL_DOMAIN=tunnel.homemcp.si
