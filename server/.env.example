# Copy to .env (chmod 600) and fill in real values. NEVER commit .env.
# This file contains comments and placeholders only.

# --- frps -----------------------------------------------------------------
# Shared bootstrap token between frps and every frpc. Checked by frps
# itself; per-user authorization is enforced separately by tunneld.
# Generate with: openssl rand -hex 32
FRP_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# --- tunneld ---------------------------------------------------------------
# Operator key for GET /api/v1/admin/users (X-Admin-Key header).
# Generate with: openssl rand -hex 32. Leave empty to disable the
# admin endpoint entirely.
TUNNELD_ADMIN_KEY=

# Parent domain for tenant subdomains (<username>.tunnel.homemcp.si is
# the default) and the public base URL of the tunneld API (used for
# Stripe success/cancel/portal return URLs).
TUNNEL_DOMAIN=tunnel.homemcp.si
API_PUBLIC_BASE=https://api.homemcp.si

# Per-user bandwidth cap rewritten into every proxy registration and
# enforced by frps (frp syntax: e.g. 10MB, 512KB). Applies to tenant
# traffic, not per connection.
USER_BANDWIDTH_LIMIT=10MB

# --- internal testing ------------------------------------------------------
# TUNNELD_MOCK_PAY=1 replaces Stripe with an internal mock checkout
# (server-local /mock-pay/<enrollment_id> page + admin-only
# subscription-event test hooks) so the HomeMCP client's registration
# flow can be developed before a real Stripe account exists.
# WARNING: NEVER enable in production — anyone holding an enrollment
# link can activate a subscription for free. Internal/dev only.
TUNNELD_MOCK_PAY=0

# --- Stripe ----------------------------------------------------------------
# Test-mode keys until go-live. Secret key + webhook signing secret come
# from the Stripe dashboard; tunneld degrades to 503
# stripe_not_configured while these are empty, and frps keeps running.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (Stripe dashboard -> Products). Pricing rules they encode:
#   STRIPE_PRICE_ANNUAL   $9.99/year — 7-day free trial, card collected
#                         upfront at checkout, auto-charged when the
#                         trial ends. (trial/config set by tunneld)
#   STRIPE_PRICE_MONTHLY  $0.99/month — no trial, charged immediately.
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=

# --- Cloudflare DNS (per-user certificates, DNS-01) -------------------
# Zone-scoped API token (Zone -> DNS -> Edit, this zone only) + the
# zone ID from the Cloudflare dashboard. tunneld uses it for exactly
# one thing: publishing and removing the _acme-challenge TXT record
# for a user's OWN subdomain, so their client can obtain a per-user
# Let's Encrypt certificate (the TLS private key never leaves the
# client; see tunneld/certs.go). Both empty disables the certificate
# endpoints (503 cert_dns_not_configured).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
